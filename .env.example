# Public origin, used for canonical links, Open Graph images, robots.txt and
# the sitemap. A bare hostname is accepted and assumed to be https.
#
# On Vercel this is optional: the project's production domain is used when it
# is not set. Anywhere else, set it before deploying, or those URLs will point
# at localhost. The production build warns when it is missing.
NEXT_PUBLIC_SITE_URL=https://example.com

# Local reconstruction runs (development only). The folder the reconstruction
# worker in WSL writes its runs to, as Windows sees it. /workspace/reconstruction
# lists them and opens each in the workspace. Leave unset anywhere else: the
# /api/reconstructions/local routes then answer 404 and read nothing.
# DATUM_RECONSTRUCTION_RUNS=\wsl.localhost\Ubuntu\home\datum\datum-recon\runs
#
# Reconstructing an uploaded photograph (Phase 7). With the runs folder set,
# /workspace sends a photograph to POST /api/reconstructions/local/jobs, which
# keeps it in <runs>/.jobs/<runId>/ and runs the existing worker in WSL, one
# job at a time:  wsl.exe -d <distro> --cd <worker> --exec .venv/bin/python
# -m reconstruction.worker. The distro, the Linux runs path and the worker
# folder (the runs folder's parent) are all read from the path above; set
# these only to override them.
# DATUM_RECONSTRUCTION_WSL_DISTRO=Ubuntu
# DATUM_RECONSTRUCTION_LINUX_RUNS=/home/datum/datum-recon/runs
# DATUM_RECONSTRUCTION_WORKER_DIR=/home/datum/datum-recon
# A worker still running after this long is stopped (default 5 minutes).
# DATUM_RECONSTRUCTION_TIMEOUT_MS=300000
# Failed jobs are removed after this many days (default 7).
# DATUM_RECONSTRUCTION_RETAIN_FAILED_DAYS=7
# Uploaded originals of finished runs are kept unless this is set (days).
# DATUM_RECONSTRUCTION_RETAIN_ORIGINALS_DAYS=30
# Tests only: a stand-in worker (a JSON array of command and arguments).
# Ignored by `next start` unless DATUM_RECONSTRUCTION_ALLOW_TEST_WORKER=1.
# DATUM_RECONSTRUCTION_WORKER_COMMAND=["node","tests/fixtures/reconstruction/fake-worker.mjs"]

# The design agent (Phase 6), server-only. Off unless DATUM_DESIGN_AGENT is
# "groq" or "anthropic"; off, the workspace reads every request with its
# deterministic rules, exactly as before. On, questions, design briefs and
# words the rules can't read go to the model, whose structured reply is
# validated on the server before anything is built from it. Never prefix
# these with NEXT_PUBLIC_. Real keys belong in .env.local (gitignored) and
# must never be committed.
#
# Groq (current provider). Without GROQ_API_KEY the agent stays off.
# DATUM_DESIGN_AGENT=groq
# GROQ_API_KEY=...
# DATUM_DESIGN_AGENT_MODEL=openai/gpt-oss-120b
#
# Anthropic (alternative).
# DATUM_DESIGN_AGENT=anthropic
# ANTHROPIC_API_KEY=...
# DATUM_DESIGN_AGENT_MODEL=claude-opus-5
#
# Both providers. DATUM_DESIGN_AGENT_MODEL is optional: unset, it defaults to
# the model shown for the provider.
# DATUM_DESIGN_AGENT_EFFORT=low
# DATUM_DESIGN_AGENT_TIMEOUT_MS=30000
