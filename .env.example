# Public origin, used for canonical links, Open Graph images, robots.txt and
# the sitemap. A bare hostname is accepted and assumed to be https.
#
# On Vercel this is optional: the project's production domain is used when it
# is not set. Anywhere else, set it before deploying, or those URLs will point
# at localhost. The production build warns when it is missing.
NEXT_PUBLIC_SITE_URL=https://example.com

# Local reconstruction runs (development only). The folder the reconstruction
# worker in WSL writes its runs to, as Windows sees it. /workspace/reconstruction
# lists them and opens each in the workspace. Leave unset anywhere else: the
# /api/reconstructions/local routes then answer 404 and read nothing.
# DATUM_RECONSTRUCTION_RUNS=\wsl.localhost\Ubuntu\home\datum\datum-recon\runs
